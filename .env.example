# --- App ---
PROJECT_NAME="Smart Citizen Complaint Management System"
API_V1_STR="/api/v1"

# --- Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/smart_citizen"

# --- Supabase (placeholders) ---
# This template only decodes JWT payloads (no signature verification).
SUPABASE_URL="https://your-project-ref.supabase.co"
# Optional in backend runtime, required in frontend runtime.
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Optional strict claim check (often "authenticated")
# SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_MOCK_VERIFY="true"

# --- Auth ---
# Set this to true so the app can skip auth in swagger in development
DEV_SKIP_AUTH="true"

# --- AI / ML ---
# Enable AI-assisted auto-category assignment on report creation.
AI_ENABLED="true"

# Preload the HuggingFace model during app startup (avoids first-request latency).
AI_PRELOAD_ON_STARTUP="false"

# Minimum confidence threshold (0.0-1.0). Set to 0 to disable thresholding.
AI_MIN_CONFIDENCE="0.0"

# Category name to use when classification fails / is low-confidence.
AI_DEFAULT_CATEGORY_NAME="Other"

# Cache TTL for repeated classification results (seconds). Set to 0 to disable.
AI_CACHE_TTL_SECONDS="300"

# HuggingFace zero-shot classifier settings.
AI_HF_MODEL="facebook/bart-large-mnli"
# AI_HF_REVISION=""  # optional: pin a specific revision/commit hash
AI_HF_DEVICE="-1"    # -1=CPU, 0=first CUDA GPU, ...

# OpenAI fallback (requires OPENAI_API_KEY in your environment)
AI_OPENAI_FALLBACK_ENABLED="false"
AI_OPENAI_MODEL="gpt-4o-mini"
AI_OPENAI_TIMEOUT_SECONDS="15"

# OPENAI_API_KEY=""

# Optional: persist AI-generated confirmation messages as report comments.
# Must be a valid UUID of an existing user (e.g. the seeded admin user).
# AI_CONFIRMATION_COMMENT_USER_ID="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"

