server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # gzip text assets — Vite's hashed bundles compress well
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cache hashed assets aggressively; never cache index.html
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Proxy API to the internal backend Container App.
    # Trailing slash on proxy_pass strips the /api/ prefix and substitutes /api/v1/,
    # matching FastAPI's settings.api_v1_str mount point.
    location /api/ {
        proxy_pass         https://${BACKEND_FQDN}/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 6m;
    }

    # Backend-served upload assets (PDFs/images uploaded by users).
    location /static/ {
        proxy_pass         https://${BACKEND_FQDN}/static/;
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_ssl_server_name on;
    }

    # SPA fallback for React Router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
